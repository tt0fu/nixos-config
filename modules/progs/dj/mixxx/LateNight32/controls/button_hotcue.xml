<!-- A hotcue button. The only variable that needs to be specified is "number".
     HotcueBtnWidth / HotcueBtnHeight (optional, default 26) control the size. -->
<Template>
  <WidgetGroup>
    <ObjectName>Hotcue<Variable name="number"/></ObjectName>
    <MinimumSize><Variable name="HotcueBtnWidth"/>,<Variable name="HotcueBtnHeight"/></MinimumSize>
    <MaximumSize><Variable name="HotcueBtnWidth"/>,<Variable name="HotcueBtnHeight"/></MaximumSize>
    <SizePolicy>me,f</SizePolicy>
    <Layout>horizontal</Layout>
    <Children>
      <HotcueButton>
        <TooltipId>hotcue</TooltipId>
        <ObjectName>HotcueButton</ObjectName>
        <MinimumSize><Variable name="HotcueBtnWidth"/>,<Variable name="HotcueBtnHeight"/></MinimumSize>
        <MaximumSize><Variable name="HotcueBtnWidth"/>,<Variable name="HotcueBtnHeight"/></MaximumSize>
        <SizePolicy>me,f</SizePolicy>
        <Group><Variable name="Group"/></Group>
        <Hotcue><Variable name="number"/></Hotcue>
        <NumberStates>3</NumberStates>
        <DimBrightThreshold><Variable name="DimBrightThresholdHotcueBtn"/></DimBrightThreshold>
        <State>
          <Number>0</Number>
          <Text><Variable name="number"/></Text>
          <Alignment>center</Alignment>
          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_square.svg</Unpressed>
          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_square_active.svg</Pressed>
        </State>
        <State>
          <Number>1</Number>
          <Text><Variable name="number"/></Text>
          <Alignment>center</Alignment>
          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_square_set.svg</Unpressed>
          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_square_active.svg</Pressed>
        </State>
        <State>
          <Number>2</Number>
          <Text><Variable name="number"/></Text>
          <Alignment>center</Alignment>
          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_square_set.svg</Unpressed>
          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_square_active.svg</Pressed>
        </State>
      </HotcueButton>
    </Children>
  </WidgetGroup>
</Template>
